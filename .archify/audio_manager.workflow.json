{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Audio Records Management Workflow",
    "subtitle": "กระบวนการจัดการข้อมูลและบันทึกผลการวิเคราะห์ไฟล์เสียง",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": ".archify/audio_manager_workflow.html"
  },
  "lanes": [
    { "id": "client", "label": "Client / Ingestion" },
    { "id": "auth_lane", "label": "Auth & Gatekeeper", "variant": "exception" },
    { "id": "manager", "label": "Audio Manager Service" },
    { "id": "storage", "label": "Database & Analysis Engine" }
  ],
  "phases": [
    { "id": "phase_in", "label": "Intake & Auth", "fromCol": 0, "toCol": 1 },
    { "id": "phase_process", "label": "Process & Verify", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "phase_out", "label": "Persistence & Response", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "auth_guard", "label": "Access Guard", "lane": "auth_lane", "fromCol": 1, "toCol": 2, "variant": "security" },
    { "id": "db_persist", "label": "Data Operations", "lane": "storage", "fromCol": 3, "toCol": 4, "variant": "emphasis" }
  ],
  "mainPath": ["fe_req", "auth_check", "route_op", "db_op", "resp_ok"],
  "nodes": [
    { "id": "fe_req", "lane": "client", "col": 0, "type": "frontend", "label": "Client Request", "sublabel": "ดูผล / ประวัติ / ลบข้อมูล", "width": 140 },
    { "id": "auth_check", "lane": "auth_lane", "col": 1, "type": "security", "label": "Auth Check", "sublabel": "User ID / Session ID", "tag": "Verify Identity", "width": 140 },
    { "id": "auth_fail", "lane": "auth_lane", "col": 2, "type": "security", "label": "Unauthorized", "sublabel": "Error 401 / 403", "width": 130 },
    { "id": "route_op", "lane": "manager", "col": 2, "type": "backend", "label": "Audio Manager", "sublabel": "ตรวจสอบเงื่อนไข & คำขอ", "width": 150 },
    { "id": "ana_in", "lane": "storage", "col": 2, "type": "cloud", "label": "Analysis Result", "sublabel": "จาก Analysis Engine", "tag": "Job ID + Result", "width": 140 },
    { "id": "db_op", "lane": "storage", "col": 3, "type": "database", "label": "Database Engine", "sublabel": "บันทึก / ดึงประวัติ / ลบ", "width": 140 },
    { "id": "resp_ok", "lane": "client", "col": 4, "type": "frontend", "label": "Success Response", "sublabel": "Audio ID, Job ID, Result", "tag": "Status: OK", "width": 140 },
    { "id": "resp_fail", "lane": "manager", "col": 4, "type": "backend", "label": "Failed Response", "sublabel": "Error Code & Message", "tag": "Status: Failed", "width": 140 }
  ],
  "edges": [
    { "id": "e_fe_auth", "from": "fe_req", "to": "auth_check", "label": "คำขอ", "variant": "default" },
    { "id": "e_auth_ok", "from": "auth_check", "to": "route_op", "label": "ผ่านการยืนยัน", "variant": "emphasis" },
    { "id": "e_auth_err", "from": "auth_check", "to": "auth_fail", "label": "สิทธิ์ไม่ถูกต้อง", "variant": "security", "role": "error" },
    { "id": "e_fail_ret", "from": "auth_fail", "to": "resp_fail", "label": "Reject", "variant": "dashed", "role": "error" },
    { "id": "e_ana_route", "from": "ana_in", "to": "db_op", "label": "บันทึกผลวิเคราะห์", "variant": "emphasis" },
    { "id": "e_op_db", "from": "route_op", "to": "db_op", "label": "CRUD Operation", "variant": "emphasis" },
    { "id": "e_db_done", "from": "db_op", "to": "resp_ok", "label": "สำเร็จ", "variant": "emphasis" },
    { "id": "e_db_err", "from": "db_op", "to": "resp_fail", "label": "ผิดพลาด", "variant": "dashed", "role": "error" }
  ]
}